pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    stages {

        stage('Ensure Echo Running') {
            steps {
                powershell '''
$serviceName = "FactoryTalk Logix Echo Service"

Write-Host "Checking Echo service..."

$service = Get-Service -Name $serviceName -ErrorAction SilentlyContinue

if (-not $service) {
    throw "Echo service not found"
}

if ($service.Status -ne "Running") {
    Write-Host "Starting Echo service..."
    Start-Service -Name $serviceName
    Start-Sleep -Seconds 5
}

# Re-check status
$service = Get-Service -Name $serviceName

if ($service.Status -ne "Running") {
    throw "Echo service failed to start"
}

Write-Host "Echo service is running"

# Verify port is open (gRPC)
$portCheck = netstat -ano | findstr 50051

if (-not $portCheck) {
    throw "Echo is not listening on port 50051"
}

Write-Host "Echo port verified"
'''
            }
        }

        stage('Test') {
            steps {

                echo "=== CLEAN CI TEST START ==="

                powershell '''
$nugetConfig = "nuget.config"

Write-Host "=== CREATE LOCAL NUGET CONFIG ==="

@"
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="RockwellSDK" value="C:\\nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
"@ | Out-File -Encoding utf8 $nugetConfig

Write-Host "=== MOVE TO PROJECT ==="

cd 2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp

dir

Write-Host "=== RESTORE ==="
dotnet restore --configfile ..\\..\\..\\..\\nuget.config --no-cache -v normal

Write-Host "=== BUILD ==="
dotnet build -c Release --no-restore
'''

                echo "Running executable..."

                bat """
${env.WORKSPACE}\\2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp\\bin\\Release\\net8.0\\UnitTesting_ConsoleApp.exe
"""

                echo "=== CLEAN CI TEST END ==="
            }
        }

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
    }
}