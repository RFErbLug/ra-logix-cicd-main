pipeline {
    agent any

    triggers { 
        pollSCM('* * * * *')
    }

    stages {

        stage('Test') {
            steps {
                script {
                    echo "=== CLEAN CI TEST START ==="

                    powershell """
cd ${env.WORKSPACE}\\2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp

echo Adding Rockwell SDK NuGet source...
dotnet nuget add source "C:\\Program Files (x86)\\Rockwell Automation SDKs" -n RockwellSDK || echo Source may already exist

echo Restoring packages...
dotnet restore

echo Cleaning...
dotnet clean

echo Building...
dotnet build -c Release
"""

                    echo "Running executable..."

                    bat """
${env.WORKSPACE}\\2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp\\bin\\Release\\net8.0\\UnitTesting_ConsoleApp.exe
"""

                    echo "=== CLEAN CI TEST END ==="
                }
            }
        }

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
    }
}