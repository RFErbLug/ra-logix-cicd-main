pipeline {
    agent any

    triggers { 
        pollSCM('* * * * *')
    }

    stages {

        stage('Test') {
            steps {
                script {
                    echo "=== CLEAN CI TEST START ==="

                    powershell '''
$nugetConfig = "nuget.config"

Write-Host "=== CREATE LOCAL NUGET CONFIG ==="

@"
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="RockwellSDK" value="C:\\nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
"@ | Out-File -Encoding utf8 $nugetConfig

Write-Host "=== USING CONFIG ==="
Get-Content $nugetConfig

Write-Host "=== RESTORE ==="
dotnet restore --configfile $nugetConfig --no-cache -v normal

Write-Host "=== BUILD ==="
dotnet build -c Release --no-restore
'''
                    echo "Running executable..."

                    bat """
${env.WORKSPACE}\\2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp\\bin\\Release\\net8.0\\UnitTesting_ConsoleApp.exe
"""

                    echo "=== CLEAN CI TEST END ==="
                }
            }
        }

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
    }
}