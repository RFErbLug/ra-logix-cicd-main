pipeline {
    agent any

    stages {
        stage('Restore') {
            steps {
                powershell '''
@"
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="LocalV3" value="C:\\nuget-local-v3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
"@ | Out-File -Encoding utf8 nuget.config

dotnet nuget locals all --clear

cd 2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp

dotnet restore UnitTesting_ConsoleApp.csproj --configfile ..\\..\\..\\..\\nuget.config --no-cache --force -v minimal
'''
            }
        }

        stage('Build') {
            steps {
                powershell '''
cd 2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp
dotnet build UnitTesting_ConsoleApp.csproj -c Release --no-restore
'''
            }
        }

        stage('Run') {
            steps {
                bat """
${env.WORKSPACE}\\2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp\\bin\\Release\\net8.0\\UnitTesting_ConsoleApp.exe
"""
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'SUCCESS'
        }
        failure {
            echo 'FAILURE: Check logs above.'
        }
    }
}