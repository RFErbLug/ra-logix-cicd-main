pipeline {
    agent any

    triggers { 
        pollSCM('* * * * *')
    }

    stages {

        stage('Test') {
            steps {
                script {
                    echo "=== CLEAN CI TEST START ==="

                    powershell '''
Write-Host "=== FIXING NUGET SOURCE ==="

try {
    dotnet nuget remove source RockwellSDK
} catch {
    Write-Host "NuGet source not present (ok)"
}

dotnet nuget add source "C:\\Program Files (x86)\\Rockwell Automation SDKs" -n RockwellSDK

Write-Host "=== RESTORE (DETAILED) ==="
dotnet restore -v detailed

Write-Host "=== BUILD ==="
dotnet build -c Release
'''
                    echo "Running executable..."

                    bat """
${env.WORKSPACE}\\2-cicd-config\\1-ci-teststage\\2-ci-unittestscript\\UnitTesting_ConsoleApp\\bin\\Release\\net8.0\\UnitTesting_ConsoleApp.exe
"""

                    echo "=== CLEAN CI TEST END ==="
                }
            }
        }

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
    }
}